; Shared extraction settings. Not part of the installed package, so importing
; Hylo does not change anyone's extraction options.

(rocq.theory
 (name Hylo.Extraction)
 (theories Stdlib Paco Hylo)
 (flags :standard -w -rewrite-rw,-missing-proof-command))

(library
 (name bigint)
 (wrapped false)
 (modules bigint)
 (libraries zarith))
