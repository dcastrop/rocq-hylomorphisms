; Shared extraction settings, installed with the package. They are a separate
; theory, so importing Hylo alone does not change anyone's extraction options.

(rocq.theory
 (name Hylo.Extraction)
 (package rocq-hylomorphisms)
 (theories Stdlib Paco Hylo))

(library
 (name bigint)
 (wrapped false)
 (modules bigint)
 (libraries zarith))
