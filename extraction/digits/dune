; Extracts digits.ml (in _build/default/extraction/digits/) and compiles it, so that
; broken extraction is caught by the build. Uint63 comes from the Rocq kernel.

(rocq.extraction
 (prelude ExtrDigits)
 (extracted_modules digits)
 (theories Stdlib Paco elpi elpi_elpi elpi.apps.coercion Hylo Hylo.Examples Hylo.Extraction))

(library
 (name extracted_digits)
 (wrapped false)
 (modules digits)
 (libraries rocq-runtime.kernel)
 (flags :standard -w -a))

(executable
 (name main)
 (modules main)
 (libraries extracted_digits))
