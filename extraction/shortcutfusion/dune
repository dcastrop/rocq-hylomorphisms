; Extracts shortcutfusion.ml (in _build/default/extraction/shortcutfusion/) and compiles it, so that
; broken extraction is caught by the build. Uint63 comes from the Rocq kernel.

(rocq.extraction
 (prelude ExtrShortcutFusion)
 (extracted_modules shortcutfusion)
 (theories Stdlib Paco Hylo Hylo.Examples Hylo.Extraction)
 (flags :standard -w +all))

(library
 (name extracted_shortcutfusion)
 (wrapped false)
 (modules shortcutfusion)
 (libraries rocq-runtime.kernel)
 (flags :standard -w -a))

(executable
 (name main)
 (modules main)
 (libraries extracted_shortcutfusion))
