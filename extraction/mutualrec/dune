; Extracts mutualrec.ml (in _build/default/extraction/mutualrec/) and compiles it, so that
; broken extraction is caught by the build. Uint63 comes from the Rocq kernel.

(rocq.extraction
 (prelude ExtrMutualRec)
 (extracted_modules mutualrec)
 (theories Stdlib Paco Hylo Hylo.Examples Hylo.Extraction)
 (flags :standard -w -extraction-default-directory))

(library
 (name extracted_mutualrec)
 (wrapped false)
 (modules mutualrec)
 (libraries rocq-runtime.kernel)
 (flags :standard -w -a))

(executable
 (name main)
 (modules main)
 (libraries extracted_mutualrec))
